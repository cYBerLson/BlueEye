# Satellite works by default using NASA GIBS Blue Marble imagery (source zoom 0–8).
# Optional replacement: licensed satellite raster provider. HTTPS XYZ URL and attribution required.
# These variables are PUBLIC and included in the browser bundle. Never use private keys.
# Use only a provider URL / token explicitly approved for public browser use.
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=
# Maximum source tile zoom for an optional replacement provider (default 18).
VITE_SATELLITE_MAX_ZOOM=18
